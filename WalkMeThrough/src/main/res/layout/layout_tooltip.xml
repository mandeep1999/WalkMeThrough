<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/tooltip_arrow_up"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:contentDescription="@null"
        android:src="@drawable/tooltip_arrow_up"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/tooltip_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/curve_background_with_border"
        android:maxWidth="280dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tooltip_title_text_view"
            style="@style/TitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            tools:text="Tooltip title" />

        <TextView
            android:id="@+id/tooltip_description_text_view"
            style="@style/DescriptionTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="Short hint text" />

    </LinearLayout>

    <ImageView
        android:id="@+id/tooltip_arrow_down"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:contentDescription="@null"
        android:src="@drawable/tooltip_arrow_down"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
